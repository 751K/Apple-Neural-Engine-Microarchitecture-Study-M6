program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.2"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<E5Backend_ios16>(tensor<fp16, [1, 64, 256]> x0) {
            tensor<fp16, [1, 64, 256]> x0_ane = transfer(from = string("ane"), to = string("ane"), values = x0);
            tensor<fp16, [1, 64, 256]> wrap_in0_1_relu_ane = call(x0_ane = x0_ane)[backend = string("ane"), function = string("main_ane")];
            tensor<fp16, [1, 64, 256]> wrap_in0_1_relu_bnns = transfer(from = string("ane"), to = string("bnns"), values = wrap_in0_1_relu_ane);
            tensor<fp16, [1, 64, 63, 8]> wrap_out_1_relu_bnns = call(wrap_in0_1_relu_bnns = wrap_in0_1_relu_bnns)[backend = string("bnns"), function = string("main_bnns")];
            tensor<fp16, [1, 64, 63, 8]> wrap_out_1_relu = transfer(from = string("bnns"), to = string("bnns"), values = wrap_out_1_relu_bnns);
        } -> (wrap_out_1_relu);
    func main_ane<ios18>(tensor<fp16, [1, 64, 256]> x0_ane) {
            tensor<fp16, [1, 64, 256]> wrap_in0_0_lin = linear(bias = tensor<fp16, [256]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(131200))), weight = tensor<fp16, [256, 256]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(64))), x = x0_ane)[milId = uint64(0), name = string("wrap_in0_0_lin")];
            tensor<fp16, [1, 64, 256]> wrap_in0_0_relu = relu(x = wrap_in0_0_lin)[milId = uint64(1), name = string("wrap_in0_0_relu")];
            tensor<fp16, [1, 64, 256]> wrap_in0_1_lin = linear(bias = tensor<fp16, [256]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(131200))), weight = tensor<fp16, [256, 256]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(131776))), x = wrap_in0_0_relu)[milId = uint64(2), name = string("wrap_in0_1_lin")];
            tensor<fp16, [1, 64, 256]> wrap_in0_1_relu_ane = relu(x = wrap_in0_1_lin)[milId = uint64(3), name = string("wrap_in0_1_relu")];
        } -> (wrap_in0_1_relu_ane);
    func main_bnns<ios18>(tensor<fp16, [1, 64, 256]> wrap_in0_1_relu_bnns) {
            tensor<fp16, [1, 64, 63, 8]> sliding_windows_0 = sliding_windows(axis = int32(2), size = int32(8), stride = int32(4), x = wrap_in0_1_relu_bnns)[milId = uint64(4), name = string("sliding_windows_0")];
            tensor<fp16, [1, 64, 63, 8]> wrap_out_0_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [64, 64, 3, 3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(262912))), x = sliding_windows_0)[milId = uint64(5), name = string("wrap_out_0_conv")];
            tensor<fp16, [1, 64, 63, 8]> wrap_out_0_relu = relu(x = wrap_out_0_conv)[milId = uint64(6), name = string("wrap_out_0_relu")];
            tensor<fp16, [1, 64, 63, 8]> wrap_out_1_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [64, 64, 3, 3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(336704))), x = wrap_out_0_relu)[milId = uint64(7), name = string("wrap_out_1_conv")];
            tensor<fp16, [1, 64, 63, 8]> wrap_out_1_relu_bnns = relu(x = wrap_out_1_conv)[milId = uint64(8), name = string("wrap_out_1_relu")];
        } -> (wrap_out_1_relu_bnns);
