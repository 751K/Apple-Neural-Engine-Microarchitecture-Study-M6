program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.2"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<E5Backend_ios16>(tensor<fp16, [1, 1, 1, 65536]> x0) {
            tensor<fp16, [1, 1, 1, 65536]> x0_bnns = transfer(from = string("bnns"), to = string("bnns"), values = x0);
            tensor<fp16, [1, 1, 1, 65536]> wrap_out_1_relu_bnns = call(x0_bnns = x0_bnns)[backend = string("bnns"), function = string("main_bnns")];
            tensor<fp16, [1, 1, 1, 65536]> wrap_out_1_relu = transfer(from = string("bnns"), to = string("bnns"), values = wrap_out_1_relu_bnns);
        } -> (wrap_out_1_relu);
    func main_bnns<ios18>(tensor<fp16, [1, 1, 1, 65536]> x0_bnns) {
            tensor<fp16, [1, 1, 1, 65536]> wrap_in0_0_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [1, 1, 3, 3]>([[[[-0x1.518p-4, 0x1.268p-5, 0x1.314p-4], [-0x1.dp-5, 0x1.4c8p-5, 0x1.79p-6], [0x1.878p-6, 0x1.74cp-6, -0x1.c54p-5]]]]), x = x0_bnns)[milId = uint64(0), name = string("wrap_in0_0_conv")];
            tensor<fp16, [1, 1, 1, 65536]> wrap_in0_0_relu = relu(x = wrap_in0_0_conv)[milId = uint64(1), name = string("wrap_in0_0_relu")];
            tensor<fp16, [1, 1, 1, 65536]> wrap_in0_1_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [1, 1, 3, 3]>([[[[0x1.f0cp-6, -0x1.65p-5, 0x1.f24p-5], [-0x1.298p-13, -0x1.02p-6, -0x1.b98p-15], [0x1.bf4p-10, -0x1.6b8p-10, -0x1.c4cp-6]]]]), x = wrap_in0_0_relu)[milId = uint64(2), name = string("wrap_in0_1_conv")];
            tensor<fp16, [1, 1, 1, 65536]> wrap_in0_1_relu = relu(x = wrap_in0_1_conv)[milId = uint64(3), name = string("wrap_in0_1_relu")];
            tensor<fp16, [1, 1, 1, 65536]> wrap_out_0_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [1, 1, 3, 3]>([[[[-0x1.3fp-5, -0x1.b6cp-6, -0x1.d2cp-8], [0x1.764p-9, -0x1.018p-5, 0x1.238p-6], [0x1.6dp-5, 0x1.39p-4, -0x1.5f4p-8]]]]), x = wrap_in0_1_relu)[milId = uint64(4), name = string("wrap_out_0_conv")];
            tensor<fp16, [1, 1, 1, 65536]> wrap_out_0_relu = relu(x = wrap_out_0_conv)[milId = uint64(5), name = string("wrap_out_0_relu")];
            tensor<fp16, [1, 1, 1, 65536]> wrap_out_1_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [1, 1, 3, 3]>([[[[-0x1.d14p-5, -0x1.89p-4, -0x1.b68p-5], [0x1.44p-5, 0x1.534p-5, 0x1.6bp-6], [0x1.6dcp-5, 0x1.62p-5, -0x1.c1p-6]]]]), x = wrap_out_0_relu)[milId = uint64(6), name = string("wrap_out_1_conv")];
            tensor<fp16, [1, 1, 1, 65536]> wrap_out_1_relu_bnns = relu(x = wrap_out_1_conv)[milId = uint64(7), name = string("wrap_out_1_relu")];
        } -> (wrap_out_1_relu_bnns);
}