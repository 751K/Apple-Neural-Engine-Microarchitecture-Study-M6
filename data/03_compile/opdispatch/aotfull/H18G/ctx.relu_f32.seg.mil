program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.2"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<E5Backend_ios16>(tensor<fp32, [1, 64, 32, 32]> x0) {
            tensor<fp32, [1, 64, 32, 32]> x0_classic_cpu = transfer(from = string("classic_cpu"), to = string("classic_cpu"), values = x0);
            tensor<fp32, [1, 64, 32, 32]> relu_0_classic_cpu = call(x0_classic_cpu = x0_classic_cpu)[backend = string("classic_cpu"), function = string("main_classic_cpu")];
            tensor<fp32, [1, 64, 32, 32]> relu_0 = transfer(from = string("classic_cpu"), to = string("classic_cpu"), values = relu_0_classic_cpu);
        } -> (relu_0);
    func main_classic_cpu<ios18>(tensor<fp32, [1, 64, 32, 32]> x0_classic_cpu) {
            tensor<fp16, [1, 64, 32, 32]> x0_to_fp16 = cast(dtype = string("fp16"), x = x0_classic_cpu)[milId = uint64(0), name = string("cast_1")];
            tensor<fp16, [1, 64, 32, 32]> relu_0_cast_fp16 = relu(x = x0_to_fp16)[milId = uint64(1), name = string("relu_0_cast_fp16")];
            tensor<fp32, [1, 64, 32, 32]> relu_0_classic_cpu = cast(dtype = string("fp32"), x = relu_0_cast_fp16)[milId = uint64(2), name = string("cast_0")];
        } -> (relu_0_classic_cpu);
}