program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.2"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<E5Backend_ios16>(tensor<fp16, [1, 1, 65537, 1]> x0) {
            tensor<fp16, [1, 1, 65537, 1]> x0_bnns = transfer(from = string("bnns"), to = string("bnns"), values = x0);
            tensor<fp16, [1, 1, 65537, 1]> wrap_out_1_relu_bnns = call(x0_bnns = x0_bnns)[backend = string("bnns"), function = string("main_bnns")];
            tensor<fp16, [1, 1, 65537, 1]> wrap_out_1_relu = transfer(from = string("bnns"), to = string("bnns"), values = wrap_out_1_relu_bnns);
        } -> (wrap_out_1_relu);
    func main_bnns<ios18>(tensor<fp16, [1, 1, 65537, 1]> x0_bnns) {
            tensor<fp16, [1, 1, 65537, 1]> wrap_in0_0_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [1, 1, 3, 3]>([[[[-0x1.4b8p-5, -0x1.1e4p-9, 0x1.c78p-5], [-0x1.11p-6, -0x1.8f4p-9, 0x1.28p-4], [-0x1.c68p-4, 0x1.1dcp-5, -0x1.d8p-5]]]]), x = x0_bnns)[milId = uint64(0), name = string("wrap_in0_0_conv")];
            tensor<fp16, [1, 1, 65537, 1]> wrap_in0_0_relu = relu(x = wrap_in0_0_conv)[milId = uint64(1), name = string("wrap_in0_0_relu")];
            tensor<fp16, [1, 1, 65537, 1]> wrap_in0_1_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [1, 1, 3, 3]>([[[[-0x1.3bcp-9, -0x1.2cp-4, -0x1.cep-4], [0x1.4d8p-6, -0x1.89cp-5, 0x1.778p-8], [0x1.b68p-5, -0x1.95p-8, -0x1.90cp-4]]]]), x = wrap_in0_0_relu)[milId = uint64(2), name = string("wrap_in0_1_conv")];
            tensor<fp16, [1, 1, 65537, 1]> wrap_in0_1_relu = relu(x = wrap_in0_1_conv)[milId = uint64(3), name = string("wrap_in0_1_relu")];
            tensor<fp16, [1, 1, 65537, 1]> wrap_out_0_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [1, 1, 3, 3]>([[[[-0x1.51cp-5, 0x1.25cp-3, 0x1.54p-5], [-0x1.7fcp-6, -0x1.50cp-11, 0x1.d18p-6], [-0x1.8acp-8, 0x1.bfp-5, -0x1.8f8p-9]]]]), x = wrap_in0_1_relu)[milId = uint64(4), name = string("wrap_out_0_conv")];
            tensor<fp16, [1, 1, 65537, 1]> wrap_out_0_relu = relu(x = wrap_out_0_conv)[milId = uint64(5), name = string("wrap_out_0_relu")];
            tensor<fp16, [1, 1, 65537, 1]> wrap_out_1_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [1, 1, 3, 3]>([[[[-0x1.9p-6, 0x1.c74p-6, 0x1.bdp-5], [-0x1.138p-9, -0x1.72p-7, 0x1.734p-8], [0x1.8dcp-6, -0x1.4ap-7, -0x1.c54p-5]]]]), x = wrap_out_0_relu)[milId = uint64(6), name = string("wrap_out_1_conv")];
            tensor<fp16, [1, 1, 65537, 1]> wrap_out_1_relu_bnns = relu(x = wrap_out_1_conv)[milId = uint64(7), name = string("wrap_out_1_relu")];
        } -> (wrap_out_1_relu_bnns);
}