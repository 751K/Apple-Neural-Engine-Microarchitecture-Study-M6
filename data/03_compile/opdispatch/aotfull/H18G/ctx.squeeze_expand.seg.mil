program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.2"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<E5Backend_ios16>(tensor<fp16, [1, 64, 1, 32]> x0) {
            tensor<fp16, [1, 64, 1, 32]> x0_bnns = transfer(from = string("bnns"), to = string("bnns"), values = x0);
            tensor<fp16, [1, 64, 32, 1]> wrap_out_1_relu_bnns = call(x0_bnns = x0_bnns)[backend = string("bnns"), function = string("main_bnns")];
            tensor<fp16, [1, 64, 32, 1]> wrap_out_1_relu = transfer(from = string("bnns"), to = string("bnns"), values = wrap_out_1_relu_bnns);
        } -> (wrap_out_1_relu);
    func main_bnns<ios18>(tensor<fp16, [1, 64, 1, 32]> x0_bnns) {
            tensor<fp16, [1, 64, 1, 32]> wrap_in0_0_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [64, 64, 3, 3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(64))), x = x0_bnns)[milId = uint64(0), name = string("wrap_in0_0_conv")];
            tensor<fp16, [1, 64, 1, 32]> wrap_in0_0_relu = relu(x = wrap_in0_0_conv)[milId = uint64(1), name = string("wrap_in0_0_relu")];
            tensor<fp16, [1, 64, 1, 32]> wrap_in0_1_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [64, 64, 3, 3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(73856))), x = wrap_in0_0_relu)[milId = uint64(2), name = string("wrap_in0_1_conv")];
            tensor<fp16, [1, 64, 1, 32]> wrap_in0_1_relu = relu(x = wrap_in0_1_conv)[milId = uint64(3), name = string("wrap_in0_1_relu")];
            tensor<fp16, [1, 64, 32]> squeeze_0 = squeeze(axes = tensor<int32, [1]>([2]), x = wrap_in0_1_relu)[milId = uint64(4), name = string("squeeze_0")];
            tensor<fp16, [1, 64, 32, 1]> expand_dims_0 = expand_dims(axes = tensor<int32, [1]>([3]), x = squeeze_0)[milId = uint64(5), name = string("expand_dims_0")];
            tensor<fp16, [1, 64, 32, 1]> wrap_out_0_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [64, 64, 3, 3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(147648))), x = expand_dims_0)[milId = uint64(6), name = string("wrap_out_0_conv")];
            tensor<fp16, [1, 64, 32, 1]> wrap_out_0_relu = relu(x = wrap_out_0_conv)[milId = uint64(7), name = string("wrap_out_0_relu")];
            tensor<fp16, [1, 64, 32, 1]> wrap_out_1_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [64, 64, 3, 3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(221440))), x = wrap_out_0_relu)[milId = uint64(8), name = string("wrap_out_1_conv")];
            tensor<fp16, [1, 64, 32, 1]> wrap_out_1_relu_bnns = relu(x = wrap_out_1_conv)[milId = uint64(9), name = string("wrap_out_1_relu")];
