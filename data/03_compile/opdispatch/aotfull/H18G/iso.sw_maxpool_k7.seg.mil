program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.2"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<E5Backend_ios16>(tensor<fp16, [1, 64, 32, 32]> x0) {
            tensor<fp16, [1, 64, 32, 32]> x0_bnns = transfer(from = string("bnns"), to = string("bnns"), values = x0);
            tensor<fp16, [1, 64, 32, 32]> max_pool_0_bnns = call(x0_bnns = x0_bnns)[backend = string("bnns"), function = string("main_bnns")];
            tensor<fp16, [1, 64, 32, 32]> max_pool_0 = transfer(from = string("bnns"), to = string("bnns"), values = max_pool_0_bnns);
        } -> (max_pool_0);
    func main_bnns<ios18>(tensor<fp16, [1, 64, 32, 32]> x0_bnns) {
            tensor<fp16, [1, 64, 32, 32]> max_pool_0_bnns = max_pool(ceil_mode = bool(false), kernel_sizes = tensor<int32, [2]>([7, 7]), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), x = x0_bnns)[milId = uint64(0), name = string("max_pool_0")];
        } -> (max_pool_0_bnns);
}