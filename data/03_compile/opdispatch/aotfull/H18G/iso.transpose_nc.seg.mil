program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.2"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<E5Backend_ios16>(tensor<fp16, [8, 64, 16, 16]> x0) {
            tensor<fp16, [8, 64, 16, 16]> x0_bnns = transfer(from = string("bnns"), to = string("bnns"), values = x0);
            tensor<fp16, [64, 8, 16, 16]> transpose_0_bnns = call(x0_bnns = x0_bnns)[backend = string("bnns"), function = string("main_bnns")];
            tensor<fp16, [64, 8, 16, 16]> transpose_0 = transfer(from = string("bnns"), to = string("bnns"), values = transpose_0_bnns);
        } -> (transpose_0);
    func main_bnns<ios18>(tensor<fp16, [8, 64, 16, 16]> x0_bnns) {
            tensor<fp16, [64, 8, 16, 16]> transpose_0_bnns = transpose(perm = tensor<int32, [4]>([1, 0, 2, 3]), x = x0_bnns)[milId = uint64(0), name = string("transpose_1")];
        } -> (transpose_0_bnns);
}