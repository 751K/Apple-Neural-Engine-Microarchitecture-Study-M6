program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.2"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<E5Backend_ios16>(tensor<fp16, [1, 64, 32, 32]> x0) {
            tensor<fp16, [1, 64, 32, 32]> x0_ane = transfer(from = string("ane"), to = string("ane"), values = x0);
            tensor<fp16, [1, 64, 32, 32]> conv_0_ane = call(x0_ane = x0_ane)[backend = string("ane"), function = string("main_ane")];
            tensor<fp16, [1, 64, 32, 32]> conv_0 = transfer(from = string("ane"), to = string("ane"), values = conv_0_ane);
        } -> (conv_0);
    func main_ane<ios18>(tensor<fp16, [1, 64, 32, 32]> x0_ane) {
            tensor<fp16, [1, 64, 32, 32]> conv_0_ane = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [64, 64, 28, 1]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(64))), x = x0_ane)[milId = uint64(0), name = string("conv_0")];
        } -> (conv_0_ane);
}