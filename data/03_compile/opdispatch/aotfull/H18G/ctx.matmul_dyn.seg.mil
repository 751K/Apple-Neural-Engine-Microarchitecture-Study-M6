    func main<E5Backend_ios16>(tensor<fp16, [1, 128, 256]> x0, tensor<fp16, [1, 256, 128]> x1) {
            tensor<fp16, [1, 128, 256]> x0_ane = transfer(from = string("ane"), to = string("ane"), values = x0);
            tensor<fp16, [1, 256, 128]> x1_ane = transfer(from = string("ane"), to = string("ane"), values = x1);
            tensor<fp16, [1, 128, 128]> wrap_out_1_relu_ane = call(x0_ane = x0_ane, x1_ane = x1_ane)[backend = string("ane"), function = string("main_ane")];
            tensor<fp16, [1, 128, 128]> wrap_out_1_relu = transfer(from = string("ane"), to = string("ane"), values = wrap_out_1_relu_ane);
        } -> (wrap_out_1_relu);
    func main_ane<ios18>(tensor<fp16, [1, 128, 256]> x0_ane, tensor<fp16, [1, 256, 128]> x1_ane) {
            tensor<fp16, [1, 128, 256]> wrap_in0_0_lin = linear(bias = tensor<fp16, [256]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(131200))), weight = tensor<fp16, [256, 256]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(64))), x = x0_ane)[milId = uint64(0), name = string("wrap_in0_0_lin")];
            tensor<fp16, [1, 128, 256]> wrap_in0_0_relu = relu(x = wrap_in0_0_lin)[milId = uint64(1), name = string("wrap_in0_0_relu")];
            tensor<fp16, [1, 128, 256]> wrap_in0_1_lin = linear(bias = tensor<fp16, [256]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(131200))), weight = tensor<fp16, [256, 256]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(131776))), x = wrap_in0_0_relu)[milId = uint64(2), name = string("wrap_in0_1_lin")];
            tensor<fp16, [1, 128, 256]> wrap_in0_1_relu = relu(x = wrap_in0_1_lin)[milId = uint64(3), name = string("wrap_in0_1_relu")];
            tensor<fp16, [1, 256, 128]> wrap_in1_0_lin = linear(bias = tensor<fp16, [128]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(295744))), weight = tensor<fp16, [128, 128]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(262912))), x = x1_ane)[milId = uint64(4), name = string("wrap_in1_0_lin")];
            tensor<fp16, [1, 256, 128]> wrap_in1_0_relu = relu(x = wrap_in1_0_lin)[milId = uint64(5), name = string("wrap_in1_0_relu")];
            tensor<fp16, [1, 256, 128]> wrap_in1_1_lin = linear(bias = tensor<fp16, [128]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(295744))), weight = tensor<fp16, [128, 128]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(296064))), x = wrap_in1_0_relu)[milId = uint64(6), name = string("wrap_in1_1_lin")];
            tensor<fp16, [1, 256, 128]> wrap_in1_1_relu = relu(x = wrap_in1_1_lin)[milId = uint64(7), name = string("wrap_in1_1_relu")];
            tensor<fp16, [1, 128, 128]> matmul_0 = matmul(transpose_x = bool(false), transpose_y = bool(false), x = wrap_in0_1_relu, y = wrap_in1_1_relu)[milId = uint64(8), name = string("matmul_0")];
            tensor<fp16, [1, 128, 128]> wrap_out_0_lin = linear(bias = tensor<fp16, [128]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(295744))), weight = tensor<fp16, [128, 128]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(328896))), x = matmul_0)[milId = uint64(9), name = string("wrap_out_0_lin")];
            tensor<fp16, [1, 128, 128]> wrap_out_0_relu = relu(x = wrap_out_0_lin)[milId = uint64(10), name = string("wrap_out_0_relu")];
            tensor<fp16, [1, 128, 128]> wrap_out_1_lin = linear(bias = tensor<fp16, [128]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(295744))), weight = tensor<fp16, [128, 128]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(361728))), x = wrap_out_0_relu)[milId = uint64(11), name = string("wrap_out_1_lin")];
            tensor<fp16, [1, 128, 128]> wrap_out_1_relu_ane = relu(x = wrap_out_1_lin)[milId = uint64(12), name = string("wrap_out_1_relu")];
