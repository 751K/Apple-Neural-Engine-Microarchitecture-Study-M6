program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.2"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<E5Backend_ios16>(tensor<fp16, [1, 128, 256]> x0) {
            tensor<fp16, [1, 128, 256]> x0_bnns = transfer(from = string("bnns"), to = string("bnns"), values = x0);
            tensor<fp16, [1, 128, 512]> linear_0_bnns = call(x0_bnns = x0_bnns)[backend = string("bnns"), function = string("main_bnns")];
            tensor<fp16, [1, 128, 512]> linear_0 = transfer(from = string("bnns"), to = string("bnns"), values = linear_0_bnns);
        } -> (linear_0);
    func main_bnns<ios18>(tensor<fp16, [1, 128, 256]> x0_bnns) {
            tensor<fp16, [1, 128, 512]> linear_0_bnns = linear(bias = tensor<fp16, [512]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(262272))), weight = tensor<fp16, [512, 256]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(64))), x = x0_bnns)[milId = uint64(0), name = string("linear_0")];
        } -> (linear_0_bnns);
}