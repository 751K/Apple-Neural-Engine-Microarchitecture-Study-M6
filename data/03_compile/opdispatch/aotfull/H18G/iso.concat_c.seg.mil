program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.2"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<E5Backend_ios16>(tensor<fp16, [1, 64, 32, 32]> x0, tensor<fp16, [1, 64, 32, 32]> x1) {
            tensor<fp16, [1, 64, 32, 32]> x0_bnns = transfer(from = string("bnns"), to = string("bnns"), values = x0);
            tensor<fp16, [1, 64, 32, 32]> x1_bnns = transfer(from = string("bnns"), to = string("bnns"), values = x1);
            tensor<fp16, [1, 128, 32, 32]> concat_0_bnns = call(x0_bnns = x0_bnns, x1_bnns = x1_bnns)[backend = string("bnns"), function = string("main_bnns")];
            tensor<fp16, [1, 128, 32, 32]> concat_0 = transfer(from = string("bnns"), to = string("bnns"), values = concat_0_bnns);
        } -> (concat_0);
    func main_bnns<ios18>(tensor<fp16, [1, 64, 32, 32]> x0_bnns, tensor<fp16, [1, 64, 32, 32]> x1_bnns) {
            tensor<fp16, [1, 128, 32, 32]> concat_0_bnns = concat(axis = int32(1), interleave = bool(false), values = (x0_bnns, x1_bnns))[milId = uint64(0), name = string("concat_0")];
        } -> (concat_0_bnns);
}