program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.2"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<E5Backend_ios16>(tensor<fp16, [1, 1, 1, 16384]> x0) {
            tensor<fp16, [1, 1, 1, 16384]> x0_bnns = transfer(from = string("bnns"), to = string("bnns"), values = x0);
            tensor<fp16, [1, 1, 1, 16384]> wrap_out_1_relu_bnns = call(x0_bnns = x0_bnns)[backend = string("bnns"), function = string("main_bnns")];
            tensor<fp16, [1, 1, 1, 16384]> wrap_out_1_relu = transfer(from = string("bnns"), to = string("bnns"), values = wrap_out_1_relu_bnns);
        } -> (wrap_out_1_relu);
    func main_bnns<ios18>(tensor<fp16, [1, 1, 1, 16384]> x0_bnns) {
            tensor<fp16, [1, 1, 1, 16384]> wrap_in0_0_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [1, 1, 3, 3]>([[[[0x1.104p-7, -0x1.97cp-7, 0x1.a64p-4], [-0x1.678p-5, -0x1.0ep-4, 0x1.75p-6], [0x1.dc4p-6, 0x1.11cp-3, 0x1.4fcp-6]]]]), x = x0_bnns)[milId = uint64(0), name = string("wrap_in0_0_conv")];
            tensor<fp16, [1, 1, 1, 16384]> wrap_in0_0_relu = relu(x = wrap_in0_0_conv)[milId = uint64(1), name = string("wrap_in0_0_relu")];
            tensor<fp16, [1, 1, 1, 16384]> wrap_in0_1_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [1, 1, 3, 3]>([[[[-0x1.7p-7, -0x1.ecp-6, 0x1.99p-5], [0x1.afp-5, 0x1.48cp-5, 0x1.684p-6], [0x1.a84p-7, -0x1.22cp-7, 0x1.73cp-7]]]]), x = wrap_in0_0_relu)[milId = uint64(2), name = string("wrap_in0_1_conv")];
            tensor<fp16, [1, 1, 1, 16384]> wrap_in0_1_relu = relu(x = wrap_in0_1_conv)[milId = uint64(3), name = string("wrap_in0_1_relu")];
            tensor<fp16, [1, 1, 1, 16384]> wrap_out_0_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [1, 1, 3, 3]>([[[[-0x1.a1p-5, -0x1.464p-6, 0x1.f1cp-7], [-0x1.778p-5, -0x1.1f8p-5, -0x1.89cp-6], [0x1.da4p-6, 0x1.12cp-7, 0x1.018p-4]]]]), x = wrap_in0_1_relu)[milId = uint64(4), name = string("wrap_out_0_conv")];
            tensor<fp16, [1, 1, 1, 16384]> wrap_out_0_relu = relu(x = wrap_out_0_conv)[milId = uint64(5), name = string("wrap_out_0_relu")];
            tensor<fp16, [1, 1, 1, 16384]> wrap_out_1_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [1, 1, 3, 3]>([[[[0x1.388p-4, -0x1.edp-5, -0x1.894p-5], [0x1.67cp-7, -0x1.53cp-4, -0x1.13p-4], [-0x1.7cp-5, -0x1.82p-9, -0x1.59p-6]]]]), x = wrap_out_0_relu)[milId = uint64(6), name = string("wrap_out_1_conv")];
            tensor<fp16, [1, 1, 1, 16384]> wrap_out_1_relu_bnns = relu(x = wrap_out_1_conv)[milId = uint64(7), name = string("wrap_out_1_relu")];
        } -> (wrap_out_1_relu_bnns);
}