program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.2"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<E5Backend_ios16>(tensor<fp16, [1, 64, 32, 32]> x0, tensor<fp16, [1, 1, 32, 32]> x1) {
            tensor<fp16, [1, 64, 32, 32]> x0_ane = transfer(from = string("ane"), to = string("ane"), values = x0);
            tensor<fp16, [1, 1, 32, 32]> x1_ane = transfer(from = string("ane"), to = string("ane"), values = x1);
            tensor<fp16, [1, 64, 32, 32]> wrap_out_1_relu_ane = call(x0_ane = x0_ane, x1_ane = x1_ane)[backend = string("ane"), function = string("main_ane")];
            tensor<fp16, [1, 64, 32, 32]> wrap_out_1_relu = transfer(from = string("ane"), to = string("ane"), values = wrap_out_1_relu_ane);
        } -> (wrap_out_1_relu);
    func main_ane<ios18>(tensor<fp16, [1, 64, 32, 32]> x0_ane, tensor<fp16, [1, 1, 32, 32]> x1_ane) {
            tensor<fp16, [1, 64, 32, 32]> wrap_in0_0_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [64, 64, 3, 3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(64))), x = x0_ane)[milId = uint64(0), name = string("wrap_in0_0_conv")];
            tensor<fp16, [1, 64, 32, 32]> wrap_in0_0_relu = relu(x = wrap_in0_0_conv)[milId = uint64(1), name = string("wrap_in0_0_relu")];
            tensor<fp16, [1, 64, 32, 32]> wrap_in0_1_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [64, 64, 3, 3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(73856))), x = wrap_in0_0_relu)[milId = uint64(2), name = string("wrap_in0_1_conv")];
            tensor<fp16, [1, 64, 32, 32]> wrap_in0_1_relu = relu(x = wrap_in0_1_conv)[milId = uint64(3), name = string("wrap_in0_1_relu")];
            tensor<fp16, [1, 1, 32, 32]> wrap_in1_0_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [1, 1, 3, 3]>([[[[-0x1.95p-5, -0x1.42p-4, -0x1.76cp-6], [-0x1.15cp-6, -0x1.2a4p-4, -0x1.b1p-6], [0x1.8fp-5, 0x1.08p-5, -0x1.c48p-7]]]]), x = x1_ane)[milId = uint64(4), name = string("wrap_in1_0_conv")];
            tensor<fp16, [1, 1, 32, 32]> wrap_in1_0_relu = relu(x = wrap_in1_0_conv)[milId = uint64(5), name = string("wrap_in1_0_relu")];
            tensor<fp16, [1, 1, 32, 32]> wrap_in1_1_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [1, 1, 3, 3]>([[[[0x1.7ap-7, -0x1.2dp-4, 0x1.d24p-6], [-0x1.024p-3, -0x1.8d8p-4, 0x1.e9cp-6], [-0x1.98cp-6, -0x1.7d4p-5, -0x1.668p-5]]]]), x = wrap_in1_0_relu)[milId = uint64(6), name = string("wrap_in1_1_conv")];
            tensor<fp16, [1, 1, 32, 32]> wrap_in1_1_relu = relu(x = wrap_in1_1_conv)[milId = uint64(7), name = string("wrap_in1_1_relu")];
            tensor<fp16, [1, 64, 32, 32]> add_0 = add(x = wrap_in0_1_relu, y = wrap_in1_1_relu)[milId = uint64(8), name = string("add_0")];
            tensor<fp16, [1, 64, 32, 32]> wrap_out_0_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [64, 64, 3, 3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(147648))), x = add_0)[milId = uint64(9), name = string("wrap_out_0_conv")];
            tensor<fp16, [1, 64, 32, 32]> wrap_out_0_relu = relu(x = wrap_out_0_conv)[milId = uint64(10), name = string("wrap_out_0_relu")];
            tensor<fp16, [1, 64, 32, 32]> wrap_out_1_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [64, 64, 3, 3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(221440))), x = wrap_out_0_relu)[milId = uint64(11), name = string("wrap_out_1_conv")];
            tensor<fp16, [1, 64, 32, 32]> wrap_out_1_relu_ane = relu(x = wrap_out_1_conv)[milId = uint64(12), name = string("wrap_out_1_relu")];
        } -> (wrap_out_1_relu_ane);
}