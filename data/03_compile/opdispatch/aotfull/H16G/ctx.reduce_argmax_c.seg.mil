            tensor<fp16, [1, 64, 32, 32]> wrap_in0_1_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [64, 64, 3, 3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(73856))), x = wrap_in0_0_relu)[milId = uint64(2), name = string("wrap_in0_1_conv")];
            tensor<fp16, [1, 64, 32, 32]> wrap_in0_1_relu = relu(x = wrap_in0_1_conv)[milId = uint64(3), name = string("wrap_in0_1_relu")];
            tensor<int32, [1, 1, 32, 32]> reduce_argmax_0 = reduce_argmax(axis = int32(1), keep_dims = bool(true), output_dtype = string("int32"), x = wrap_in0_1_relu)[milId = uint64(4), name = string("reduce_argmax_0")];
            tensor<fp16, [1, 1, 32, 32]> cast_0 = cast(dtype = string("fp16"), x = reduce_argmax_0)[milId = uint64(5), name = string("cast_1")];
            tensor<fp16, [1, 1, 32, 32]> wrap_out_0_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [1, 1, 3, 3]>([[[[-0x1.c94p-5, 0x1.4a4p-4, 0x1.d54p-5], [-0x1.0f8p-5, 0x1.abp-7, 0x1.02cp-3], [0x1.f4cp-6, -0x1.13cp-5, -0x1.bdcp-5]]]]), x = cast_0)[milId = uint64(6), name = string("wrap_out_0_conv")];
            tensor<fp16, [1, 1, 32, 32]> wrap_out_0_relu = relu(x = wrap_out_0_conv)[milId = uint64(7), name = string("wrap_out_0_relu")];
            tensor<fp16, [1, 1, 32, 32]> wrap_out_1_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [1, 1, 3, 3]>([[[[0x1.d9cp-5, 0x1.568p-5, 0x1.14cp-5], [0x1.438p-5, -0x1.6e8p-5, 0x1.3e8p-6], [-0x1.0ecp-5, 0x1.22p-4, -0x1.11p-4]]]]), x = wrap_out_0_relu)[milId = uint64(8), name = string("wrap_out_1_conv")];
