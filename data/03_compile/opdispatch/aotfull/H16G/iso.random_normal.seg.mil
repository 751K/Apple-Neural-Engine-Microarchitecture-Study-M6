program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.2"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<E5Backend_ios16>(tensor<fp16, [1, 64, 32, 32]> x0) {
            tensor<fp16, [1, 64, 32, 32]> x0_bnns = transfer(from = string("bnns"), to = string("bnns"), values = x0);
            tensor<fp16, [1, 64, 32, 32]> add_0_bnns = call(x0_bnns = x0_bnns)[backend = string("bnns"), function = string("main_bnns")];
            tensor<fp16, [1, 64, 32, 32]> add_0 = transfer(from = string("bnns"), to = string("bnns"), values = add_0_bnns);
        } -> (add_0);
    func main_bnns<ios18>(tensor<fp16, [1, 64, 32, 32]> x0_bnns) {
            tensor<fp16, [1, 64, 32, 32]> random_normal_0_cast_fp16 = random_normal(mean = fp16(0x0p+0), seed = int32(-1), shape = tensor<int32, [4]>([1, 64, 32, 32]), stddev = fp16(0x1p+0))[milId = uint64(0), name = string("random_normal_0_cast_fp16")];
            tensor<fp16, [1, 64, 32, 32]> add_0_bnns = add(x = x0_bnns, y = random_normal_0_cast_fp16)[milId = uint64(1), name = string("add_0")];
        } -> (add_0_bnns);
}