program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.2"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<E5Backend_ios16>(tensor<fp16, [1, 8, 128, 64]> x0, tensor<fp16, [1, 8, 128, 64]> x1, tensor<fp16, [1, 8, 128, 64]> x2, tensor<fp16, [1, 1, 128, 128]> x3) {
            tensor<fp16, [1, 8, 128, 64]> x0_bnns = transfer(from = string("bnns"), to = string("bnns"), values = x0);
            tensor<fp16, [1, 8, 128, 64]> x1_bnns = transfer(from = string("bnns"), to = string("bnns"), values = x1);
            tensor<fp16, [1, 8, 128, 64]> x2_bnns = transfer(from = string("bnns"), to = string("bnns"), values = x2);
            tensor<fp16, [1, 1, 128, 128]> x3_bnns = transfer(from = string("bnns"), to = string("bnns"), values = x3);
            tensor<fp16, [1, 8, 128, 64]> wrap_out_1_relu_bnns = call(x0_bnns = x0_bnns, x1_bnns = x1_bnns, x2_bnns = x2_bnns, x3_bnns = x3_bnns)[backend = string("bnns"), function = string("main_bnns")];
            tensor<fp16, [1, 8, 128, 64]> wrap_out_1_relu = transfer(from = string("bnns"), to = string("bnns"), values = wrap_out_1_relu_bnns);
        } -> (wrap_out_1_relu);
    func main_bnns<ios18>(tensor<fp16, [1, 8, 128, 64]> x0_bnns, tensor<fp16, [1, 8, 128, 64]> x1_bnns, tensor<fp16, [1, 8, 128, 64]> x2_bnns, tensor<fp16, [1, 1, 128, 128]> x3_bnns) {
            tensor<fp16, [1, 8, 128, 64]> wrap_in0_0_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [8, 8, 3, 3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(64))), x = x0_bnns)[milId = uint64(0), name = string("wrap_in0_0_conv")];
            tensor<fp16, [1, 8, 128, 64]> wrap_in0_0_relu = relu(x = wrap_in0_0_conv)[milId = uint64(1), name = string("wrap_in0_0_relu")];
            tensor<fp16, [1, 8, 128, 64]> wrap_in0_1_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [8, 8, 3, 3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(1280))), x = wrap_in0_0_relu)[milId = uint64(2), name = string("wrap_in0_1_conv")];
            tensor<fp16, [1, 8, 128, 64]> wrap_in0_1_relu = relu(x = wrap_in0_1_conv)[milId = uint64(3), name = string("wrap_in0_1_relu")];
            tensor<fp16, [1, 8, 128, 64]> wrap_in1_0_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [8, 8, 3, 3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(2496))), x = x1_bnns)[milId = uint64(4), name = string("wrap_in1_0_conv")];
            tensor<fp16, [1, 8, 128, 64]> wrap_in1_0_relu = relu(x = wrap_in1_0_conv)[milId = uint64(5), name = string("wrap_in1_0_relu")];
            tensor<fp16, [1, 8, 128, 64]> wrap_in1_1_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [8, 8, 3, 3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(3712))), x = wrap_in1_0_relu)[milId = uint64(6), name = string("wrap_in1_1_conv")];
            tensor<fp16, [1, 8, 128, 64]> wrap_in1_1_relu = relu(x = wrap_in1_1_conv)[milId = uint64(7), name = string("wrap_in1_1_relu")];
            tensor<fp16, [1, 8, 128, 64]> wrap_in2_0_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [8, 8, 3, 3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(4928))), x = x2_bnns)[milId = uint64(8), name = string("wrap_in2_0_conv")];
            tensor<fp16, [1, 8, 128, 64]> wrap_in2_0_relu = relu(x = wrap_in2_0_conv)[milId = uint64(9), name = string("wrap_in2_0_relu")];
            tensor<fp16, [1, 8, 128, 64]> wrap_in2_1_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [8, 8, 3, 3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(6144))), x = wrap_in2_0_relu)[milId = uint64(10), name = string("wrap_in2_1_conv")];
            tensor<fp16, [1, 8, 128, 64]> wrap_in2_1_relu = relu(x = wrap_in2_1_conv)[milId = uint64(11), name = string("wrap_in2_1_relu")];
            tensor<fp16, [1, 1, 128, 128]> wrap_in3_0_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [1, 1, 3, 3]>([[[[0x1.274p-6, -0x1.044p-8, -0x1.0fcp-4], [-0x1.22cp-7, -0x1.63p-5, 0x1.5b4p-6], [-0x1.4c4p-4, 0x1.1d4p-4, 0x1.c2cp-5]]]]), x = x3_bnns)[milId = uint64(12), name = string("wrap_in3_0_conv")];
            tensor<fp16, [1, 1, 128, 128]> wrap_in3_0_relu = relu(x = wrap_in3_0_conv)[milId = uint64(13), name = string("wrap_in3_0_relu")];
            tensor<fp16, [1, 1, 128, 128]> wrap_in3_1_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [1, 1, 3, 3]>([[[[0x1.2a8p-7, 0x1.808p-7, 0x1.568p-6], [-0x1.16cp-5, 0x1.8dcp-5, 0x1.d1cp-8], [0x1.f5cp-6, 0x1.184p-4, -0x1.27p-8]]]]), x = wrap_in3_0_relu)[milId = uint64(14), name = string("wrap_in3_1_conv")];
            tensor<fp16, [1, 1, 128, 128]> wrap_in3_1_relu = relu(x = wrap_in3_1_conv)[milId = uint64(15), name = string("wrap_in3_1_relu")];
            tensor<fp16, [1, 8, 128, 64]> scaled_dot_product_attention_0 = scaled_dot_product_attention(attn_mask = wrap_in3_1_relu, key = wrap_in1_1_relu, query = wrap_in0_1_relu, value = wrap_in2_1_relu)[milId = uint64(16), name = string("scaled_dot_product_attention_0")];
            tensor<fp16, [1, 8, 128, 64]> wrap_out_0_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [8, 8, 3, 3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(7360))), x = scaled_dot_product_attention_0)[milId = uint64(17), name = string("wrap_out_0_conv")];
            tensor<fp16, [1, 8, 128, 64]> wrap_out_0_relu = relu(x = wrap_out_0_conv)[milId = uint64(18), name = string("wrap_out_0_relu")];
            tensor<fp16, [1, 8, 128, 64]> wrap_out_1_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [8, 8, 3, 3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(8576))), x = wrap_out_0_relu)[milId = uint64(19), name = string("wrap_out_1_conv")];
            tensor<fp16, [1, 8, 128, 64]> wrap_out_1_relu_bnns = relu(x = wrap_out_1_conv)[milId = uint64(20), name = string("wrap_out_1_relu")];
        } -> (wrap_out_1_relu_bnns);
}