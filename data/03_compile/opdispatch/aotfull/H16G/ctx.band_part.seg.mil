            tensor<fp16, [1, 128, 128]> wrap_in0_1_lin = linear(bias = tensor<fp16, [128]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(32896))), weight = tensor<fp16, [128, 128]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(33216))), x = wrap_in0_0_relu)[milId = uint64(2), name = string("wrap_in0_1_lin")];
