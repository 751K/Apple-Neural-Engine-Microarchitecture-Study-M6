program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.2"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<E5Backend_ios16>(tensor<fp16, [1, 64, 32, 32]> x0) {
            tensor<fp16, [1, 64, 32, 32]> x0_bnns = transfer(from = string("bnns"), to = string("bnns"), values = x0);
            tensor<fp16, [1, 64, 32, 32]> conv_0_bnns = call(x0_bnns = x0_bnns)[backend = string("bnns"), function = string("main_bnns")];
            tensor<fp16, [1, 64, 32, 32]> conv_0 = transfer(from = string("bnns"), to = string("bnns"), values = conv_0_bnns);
        } -> (conv_0);
    func main_bnns<ios18>(tensor<fp16, [1, 64, 32, 32]> x0_bnns) {
            tensor<fp16, [1, 64, 32, 32]> conv_0_bnns = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(16), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [64, 4, 3, 3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(64))), x = x0_bnns)[milId = uint64(0), name = string("conv_0")];
        } -> (conv_0_bnns);
}