program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.2"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<E5Backend_ios16>(tensor<fp16, [1, 64, 32, 32]> x0) {
            tensor<fp16, [1, 64, 32, 32]> x0_bnns = transfer(from = string("bnns"), to = string("bnns"), values = x0);
            tensor<fp16, [1, 1, 1, 1]> wrap_out_1_relu_bnns = call(x0_bnns = x0_bnns)[backend = string("bnns"), function = string("main_bnns")];
            tensor<fp16, [1, 1, 1, 1]> wrap_out_1_relu = transfer(from = string("bnns"), to = string("bnns"), values = wrap_out_1_relu_bnns);
        } -> (wrap_out_1_relu);
    func main_bnns<ios18>(tensor<fp16, [1, 64, 32, 32]> x0_bnns) {
            tensor<fp16, [1, 64, 32, 32]> wrap_in0_0_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [64, 64, 3, 3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(64))), x = x0_bnns)[milId = uint64(0), name = string("wrap_in0_0_conv")];
            tensor<fp16, [1, 64, 32, 32]> wrap_in0_0_relu = relu(x = wrap_in0_0_conv)[milId = uint64(1), name = string("wrap_in0_0_relu")];
            tensor<fp16, [1, 64, 32, 32]> wrap_in0_1_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [64, 64, 3, 3]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(73856))), x = wrap_in0_0_relu)[milId = uint64(2), name = string("wrap_in0_1_conv")];
            tensor<fp16, [1, 64, 32, 32]> wrap_in0_1_relu = relu(x = wrap_in0_1_conv)[milId = uint64(3), name = string("wrap_in0_1_relu")];
            tensor<fp16, [1, 1, 1, 1]> reduce_sum_0 = reduce_sum(axes = tensor<int32, [4]>([0, 1, 2, 3]), keep_dims = bool(true), x = wrap_in0_1_relu)[milId = uint64(4), name = string("reduce_sum_0")];
            tensor<fp16, [1, 1, 1, 1]> wrap_out_0_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [1, 1, 3, 3]>([[[[0x1.868p-5, 0x1.5c4p-4, 0x1.564p-4], [0x1.26cp-5, 0x1.114p-5, -0x1.09cp-3], [0x1.7cp-5, -0x1.4fp-8, 0x1.e2p-7]]]]), x = reduce_sum_0)[milId = uint64(5), name = string("wrap_out_0_conv")];
            tensor<fp16, [1, 1, 1, 1]> wrap_out_0_relu = relu(x = wrap_out_0_conv)[milId = uint64(6), name = string("wrap_out_0_relu")];
            tensor<fp16, [1, 1, 1, 1]> wrap_out_1_conv = conv(dilations = tensor<int32, [2]>([1, 1]), groups = int32(1), pad = tensor<int32, [4]>([0, 0, 0, 0]), pad_type = string("same"), strides = tensor<int32, [2]>([1, 1]), weight = tensor<fp16, [1, 1, 3, 3]>([[[[-0x1.60cp-6, 0x1.4d8p-4, 0x1.a98p-6], [0x1.8f8p-6, 0x1.6d8p-5, 0x1.e14p-5], [0x1.cc8p-5, 0x1.394p-8, -0x1.b24p-8]]]]), x = wrap_out_0_relu)[milId = uint64(7), name = string("wrap_out_1_conv")];
            tensor<fp16, [1, 1, 1, 1]> wrap_out_1_relu_bnns = relu(x = wrap_out_1_conv)[milId = uint64(8), name = string("wrap_out_1_relu")];
        } -> (wrap_out_1_relu_bnns);
}