program(1.3)
[buildInfo = dict<string, string>({{"coremlc-component-MIL", "3600.16.1"}, {"coremlc-version", "3600.25.2"}, {"coremltools-component-milinternal", ""}, {"coremltools-version", "9.0"}})]
{
    func main<E5Backend_ios16>(tensor<fp16, [1, 64, 32, 32]> x0) {
            tensor<fp16, [1, 64, 32, 32]> x0_bnns = transfer(from = string("bnns"), to = string("bnns"), values = x0);
            tensor<fp16, [1, 64, 32, 32]> layer_norm_0_bnns = call(x0_bnns = x0_bnns)[backend = string("bnns"), function = string("main_bnns")];
            tensor<fp16, [1, 64, 32, 32]> layer_norm_0 = transfer(from = string("bnns"), to = string("bnns"), values = layer_norm_0_bnns);
        } -> (layer_norm_0);
    func main_bnns<ios18>(tensor<fp16, [1, 64, 32, 32]> x0_bnns) {
            tensor<fp16, [1, 64, 32, 32]> layer_norm_0_bnns = layer_norm(axes = tensor<int32, [1]>([1]), epsilon = fp16(0x1.5p-17), x = x0_bnns)[milId = uint64(0), name = string("layer_norm_0_cast_fp16")];
        } -> (layer_norm_0_bnns);
}