            tensor<fp16, [1, 64, 64, 64]> relu1 = relu(x = conv1)[name = string("relu1")];
            tensor<fp16, [64, 64, 1, 1]> conv2_weight_0 = const()[name = string("conv2_weight_0"), val = tensor<fp16, [64, 64, 1, 1]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(16960)))];
            tensor<fp16, [64]> conv2_bias_0 = const()[name = string("conv2_bias_0"), val = tensor<fp16, [64]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(25216)))];
