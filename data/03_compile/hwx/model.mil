            tensor<fp16, [64, 64, 1, 1]> conv1_weight_0 = const()[name = string("conv1_weight_0"), val = tensor<fp16, [64, 64, 1, 1]>(BLOBFILE(path = string("@model_path/weights/weight.bin"), offset = uint64(8512)))];
